{
  "name": "vamos-docs",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {"pattern": "vamos-optimization.org", "custom_domain": true},
    {"pattern": "www.vamos-optimization.org", "custom_domain": true},
    {"pattern": "vamos-optimization.dev", "custom_domain": true},
    {"pattern": "www.vamos-optimization.dev", "custom_domain": true}
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
